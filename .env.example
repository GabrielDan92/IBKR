# ─────────────────────────────────────────────
# IB Gateway credentials (used by gnzsnz/ib-gateway)
#
# These are your Interactive Brokers login credentials — the same
# username and password you use to log into Client Portal, TWS, or
# IB Gateway.  Create an account at https://www.interactivebrokers.com
# if you don't have one.  Paper-trading accounts are free.
# ─────────────────────────────────────────────

# "live" for real money, "paper" for simulated trading
TRADING_MODE=paper

# 2FA settings
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWS_ACCEPT_INCOMING=accept
AUTO_RESTART_TIME="11:59 PM"
TIME_ZONE=Europe/Bucharest

# IBC dialog handling
READ_ONLY_API=no
EXISTING_SESSION_DETECTED_ACTION=primaryoverride

# Optional: VNC for debugging (comment out to disable)
# Uncomment + set a password to enable x11vnc on port 5900 inside the container.
# Then connect with any VNC viewer to 127.0.0.1:5900 to see the IB Gateway UI.

# ─────────────────────────────────────────────
# Application settings
# ─────────────────────────────────────────────
IB_GATEWAY_HOST=ib-gateway
IB_GATEWAY_PORT=4002
IB_CLIENT_ID=1

# Comma-separated list of stock symbols
SYMBOLS=AAPL,MSFT,TSLA

# Options strategy parameters
TARGET_DTE=45
DTE_RANGE_DAYS=7
SHORT_DELTA=0.30
DELTA_TOLERANCE=0.05
STRANGLE_PUT_DELTA=0.30
STRANGLE_CALL_DELTA=0.30

# Output
OUTPUT_DIR=/opt/app/data
