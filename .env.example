# IB Gateway credentials (used by gnzsnz/ib-gateway)

# Comma-separated list of stock symbols
SYMBOLS=BE,KO,UPS

# "live" for real money, "paper" for simulated trading
TRADING_MODE=paper

# 2FA settings
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWS_ACCEPT_INCOMING=accept
AUTO_RESTART_TIME="11:59 PM"
TIME_ZONE=Europe/Bucharest

# IBC dialog handling
READ_ONLY_API=no
EXISTING_SESSION_DETECTED_ACTION=primaryoverride

# Optional: VNC for debugging (comment out to disable)
# Uncomment + set a password to enable x11vnc on port 5900 inside the container.
# Then connect with any VNC viewer to 127.0.0.1:5900 to see the IB Gateway UI.
# VNC_SERVER_PASSWORD=pass

# ─────────────────────────────────────────────
# Application settings
# ─────────────────────────────────────────────
IB_GATEWAY_HOST=ib-gateway
IB_GATEWAY_PORT=4004
IB_CLIENT_ID=1

# Options strategy parameters
TARGET_DTE=45
DTE_RANGE_DAYS=30
SHORT_DELTA=0.30
DELTA_TOLERANCE=0.05
STRANGLE_PUT_DELTA=0.30
STRANGLE_CALL_DELTA=0.30

# Market data
DEFAULT_EXCHANGE=SMART
DEFAULT_CURRENCY=USD
# 1 = live, 3 = delayed, 4 = delayed-frozen
MARKET_DATA_TYPE=3
GENERIC_TICKS=100,101,106

# IBKR rate-limiting / pacing
BATCH_SIZE=45
BATCH_PAUSE_S=1.0
TICK_SETTLE_S=2.0
QUALIFY_BATCH_SIZE=100
QUALIFY_PAUSE_S=0.5

# Keep strikes within ±30% of spot
STRIKE_RANGE_PCT=0.30

# Spark
SPARK_APP_NAME=ibkr-options
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DRIVER_MEMORY=16g
SPARK_TIMEZONE=Europe/Bucharest
SPARK_LOG_LEVEL=WARN

# Dashboard
DASHBOARD_PORT=8501

# Output
OUTPUT_DIR=/opt/app/data
